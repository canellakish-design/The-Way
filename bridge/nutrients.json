  "supplements": [
    {
      "key": "vitamin_d3",
      "name": "Vitamin D3, 2000 IU",
      "note": "October to March, or when a blood test says under 75 nmol/L. 2,000 IU is the dose; no bolus loading (upper limit 4,000 IU).",
      "vitamin_d_ug": 50
    },
    {
      "key": "fish_oil",
      "name": "Fish oil, 2 capsules",
      "note": "About 600 mg EPA and DHA. Fish first (salmon, sardines twice a week); the evidence is for recovery, not performance.",
      "omega3_mg": 600
    },
    {
      "key": "magnesium",
      "name": "Magnesium glycinate, 200 mg",
      "note": "Evening, 200 mg glycinate; the supplemental limit is 350 mg a day. Two hours clear of any antibiotic.",
      "magnesium_mg": 200
    },
    {
      "key": "zinc",
      "name": "Zinc, 15 mg",
      "note": "Only when zinc has read low for a week. No immune-prevention evidence; 50 mg a day for weeks drains copper. Not with the iron.",
      "zinc_mg": 15,
      "gate": {
        "zinc_mg": 50
      }
    },
    {
      "key": "iron",
      "name": "Iron, 18 mg",
      "note": "Only with ferritin under 35 µg/L on a blood test. Morning, alternate days (absorbs 22% vs 16% daily), with vitamin C, an hour clear of coffee, tea and dairy. 100 mg elemental is the athlete protocol; 18 mg is the daily tablet.",
      "iron_mg": 18,
      "gate": {
        "iron_mg": 50
      }
    },
    {
      "key": "vitamin_c",
      "name": "Vitamin C, 500 mg",
      "note": "Food first: a pepper or an orange covers it. 500 mg a day is fine; gram doses blunt training adaptation.",
      "vitamin_c_mg": 500,
      "gate": {
        "vitamin_c_mg": 50
      }
    },
    {
      "key": "b12",
      "name": "B12, 1000 µg",
      "note": "Past 50 the gut absorbs less from food; one tablet a day covers it. Cheap and safe.",
      "b12_ug": 1000
    },
    {
      "key": "folate",
      "name": "Folate (methylfolate), 400 µg",
      "note": "On a day short of greens and beans.",
      "folate_ug": 400
    },
    {
      "key": "calcium",
      "name": "Calcium citrate, 500 mg",
      "note": "1,000 mg a day from food is the target, 1,500 in a long deficit; dairy days do not need the tablet. Away from the iron.",
      "calcium_mg": 500
    },
    {
      "key": "electrolytes",
      "name": "Electrolyte tab in a bottle",
      "note": "On the bike on hot or long days: sweat loses about 1 g of sodium an hour. The floor of 1,500 mg plus the ride is the sodium target.",
      "sodium_mg": 500,
      "potassium_mg": 150,
      "magnesium_mg": 50
    },
    {
      "key": "psyllium",
      "name": "Psyllium husk, 1 tbsp",
      "note": "In water before bed if fibre is short of 30 g.",
      "fiber_g": 5
    },
    {
      "key": "multivitamin",
      "name": "Multivitamin",
