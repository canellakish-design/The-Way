# The Way Bridge — environment (copy to .env or set as service env vars)
FUEL_TOKEN=choose-a-long-random-string
BASE_URL=https://bridge.yourdomain.com   # your Cloudflare Tunnel hostname
PORT=8420
ANTHROPIC_API_KEY=sk-ant-...
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=the-way
# Google Calendar — the day's schedule; every readable calendar is synced,
# so the coaching calendar ("16 ECNL") lands alongside primary
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# intervals.icu — the planned intervals and lifting (athlete id looks like i123456)
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=
HOME_LAT=38.97
HOME_LON=-76.50
